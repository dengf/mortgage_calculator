import { LineEdit, CheckBox, ComboBox, ListView, ScrollView, Switch, AboutSlint } from "std-widgets.slint";

struct ScenarioRow {
    id: string,
    name: string,
}

struct AmortScheduleRow {
    label: string,
    paid: string,
    principal: string,
    interest: string,
    balance: string,
}

component AppButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> small: false;
    callback clicked();

    height: small ? 30px : 38px;
    border-radius: 8px;
    border-width: 1px;
    border-color: primary ? #4f8cff : danger ? #e05252 : #2a3547;
    background: touch.pressed
        ? (primary ? #3a6fd8 : danger ? #b83f3f : #26314a)
        : touch.has-hover
            ? (primary ? #5a95ff : danger ? #e56b6b : #202a3c)
            : (primary ? #4f8cff : danger ? #d94a4a : #171f2c);

    HorizontalLayout {
        alignment: center;
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            color: (primary || danger) ? white : #d7dee8;
            font-size: small ? 12px : 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Card inherits Rectangle {
    background: #161f2e;
    border-radius: 14px;
    border-width: 1px;
    border-color: #232e42;

    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        @children
    }
}

component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;
    Text { text: root.label; color: #92a0b3; font-size: 12px; }
    @children
}

// Hand-built slider (not the std-widgets Slider) so its handle color can
// animate between states — the native widget hardcodes its own palette and
// exposes no way to recolor the handle per instance.
component RiskSlider inherits Rectangle {
    in property <float> minimum: 0.0;
    in property <float> maximum: 15.0;
    in-out property <float> value: 6.5;
    in property <float> danger-threshold: 7.0;
    // Set false to use this as a plain (always-blue) slider, e.g. for a
    // value with no risk connotation like down payment percentage.
    in property <bool> risk-coloring: true;
    callback changed(float);

    property <color> handle-color: root.risk-coloring && root.value >= root.danger-threshold ? #ef4444 : #4f8cff;
    property <float> ratio: max(0.0, min(1.0, (root.value - root.minimum) / (root.maximum - root.minimum)));

    height: 24px;
    vertical-stretch: 0;

    function set-value-from-x(x: length) {
        root.value = max(root.minimum, min(root.maximum, root.minimum + (x / root.width) * (root.maximum - root.minimum)));
        root.changed(root.value);
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        background: #232e42;
        border-radius: 2px;
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        width: root.ratio * parent.width;
        background: root.handle-color;
        border-radius: 2px;
        animate background { duration: 200ms; }
    }

    thumb := Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.handle-color;
        border-width: 2px;
        border-color: #0b1119;
        x: max(0px, min(parent.width - self.width, root.ratio * (parent.width - self.width)));
        y: (parent.height - self.height) / 2;
        animate background { duration: 200ms; }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.set-value-from-x(touch.mouse-x); }
        moved => {
            if (self.pressed) {
                root.set-value-from-x(touch.mouse-x);
            }
        }
    }
}

component RateField inherits VerticalLayout {
    in property <string> label;
    in-out property <float> rate: 6.5;
    in-out property <string> value <=> input.text;
    // Off for a rate that's just informational context (e.g. a refinance's
    // current, already-fixed rate) rather than something the red coloring
    // should read as a warning about.
    in property <bool> risk-coloring: true;
    in property <float> danger-threshold: 7.0;
    callback edited();
    callback rate-changed(float);

    spacing: 4px;
    Text { text: root.label; color: #92a0b3; font-size: 12px; }
    input := LineEdit {
        input-type: InputType.decimal;
        vertical-stretch: 0;
        edited => { root.edited(); }
    }
    RiskSlider {
        vertical-stretch: 0;
        value <=> root.rate;
        risk-coloring: root.risk-coloring;
        danger-threshold: root.danger-threshold;
        changed(v) => { root.rate-changed(v); }
    }
    if root.risk-coloring && root.rate >= root.danger-threshold: Text {
        text: "Above typical market rates";
        color: #eab308;
        font-size: 10px;
    }
}

component ResultRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> emphasize: false;
    Text { text: root.label; color: #92a0b3; font-size: 13px; vertical-alignment: center; }
    Rectangle { horizontal-stretch: 1; }
    Text {
        text: root.value;
        color: emphasize ? #7ee787 : white;
        font-size: emphasize ? 18px : 13px;
        font-weight: emphasize ? 700 : 500;
        vertical-alignment: center;
    }
}

component ErrorText inherits Text {
    color: #ff8a8a;
    font-size: 13px;
    wrap: word-wrap;
}

component TabBarButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();

    horizontal-stretch: 1;
    border-radius: 8px;
    background: active ? #4f8cff : (touch.has-hover ? #202a3c : transparent);

    HorizontalLayout {
        padding-top: 9px;
        padding-bottom: 9px;
        padding-left: 2px;
        padding-right: 2px;
        Text {
            text: root.text;
            color: active ? white : #92a0b3;
            font-size: 12px;
            font-weight: active ? 700 : 500;
            horizontal-alignment: center;
            horizontal-stretch: 1;
            // Falls back to ellipsis instead of raw clipping if a wider
            // system font (or a narrower phone width) ever leaves less
            // room than a label needs.
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component RegionOption inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();

    width: 36px;
    height: 26px;
    border-radius: 6px;
    background: active ? #4f8cff : (touch.has-hover ? #202a3c : transparent);

    Text {
        text: root.text;
        color: active ? white : #92a0b3;
        font-size: 11px;
        font-weight: active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Region selector: which country's rules (limits, upfront costs, and
// terminology) the calculators and labels below should use. Detected from
// the device locale on startup, with this as the manual override.
component RegionToggle inherits Rectangle {
    in-out property <string> region: "US";
    callback changed(string);

    background: #10161f;
    border-radius: 8px;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        RegionOption { text: "US"; active: root.region == "US"; clicked => { root.region = "US"; root.changed("US"); } }
        RegionOption { text: "SG"; active: root.region == "SG"; clicked => { root.region = "SG"; root.changed("SG"); } }
    }
}

// Top-level "About" entry point, required by the Slint royalty-free
// license's attribution clause (option a: an About screen/dialog
// reachable from the app's top-level menu, showing the AboutSlint
// widget) — see LICENSES/LicenseRef-Slint-Royalty-free-2.0.md in the
// slint crate.
component AboutButton inherits Rectangle {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: touch.has-hover ? #202a3c : transparent;

    Text {
        text: "?";
        color: #92a0b3;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { about-popup.show(); }
    }

    about-popup := PopupWindow {
        x: root.width - self.width;
        y: root.height + 6px;
        width: 260px;
        height: 170px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: #161f2e;
            border-radius: 12px;
            border-width: 1px;
            border-color: #232e42;
            clip: true;
            AboutSlint { }
        }
    }
}

// Reusable regulatory-limit banner: a ratio against a hard cap, with the
// border/background shifting amber as it approaches the limit and red once
// it's breached. Generic over whatever ratio+limit a region's rules need
// (SG's TDSR/MSR here; reusable for similar caps elsewhere).
component LimitBar inherits Rectangle {
    in property <string> label;
    in property <string> value-label;
    in property <bool> exceeded;
    in property <bool> near-limit: false;

    height: 40px;
    border-width: 1px;
    border-radius: 8px;
    background: exceeded ? #3a1414 : (near-limit ? #3a2c14 : #10161f);
    border-color: exceeded ? #ef4444 : (near-limit ? #eab308 : #232e42);
    animate background, border-color { duration: 200ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text { text: root.label; color: #92a0b3; font-size: 12px; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.value-label;
            color: exceeded ? #ff8a8a : (near-limit ? #fbbf24 : #d7dee8);
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

component SavedScenariosPanel inherits VerticalLayout {
    in property <[ScenarioRow]> scenarios: [];
    in property <string> error-text: "";
    callback save(string);
    callback load(string);
    callback delete(string);

    property <string> name-input: "";

    spacing: 10px;

    Text { text: "Saved scenarios"; font-weight: 700; font-size: 14px; }

    HorizontalLayout {
        spacing: 8px;
        LineEdit {
            placeholder-text: "Scenario name";
            text <=> root.name-input;
        }
        AppButton {
            text: "Save";
            primary: true;
            small: true;
            clicked => {
                if (name-input != "") {
                    root.save(name-input);
                    name-input = "";
                }
            }
        }
    }

    if error-text != "": ErrorText { text: error-text; }

    if scenarios.length == 0: Text {
        text: "No saved scenarios yet.";
        color: #5c6b80;
        font-size: 12px;
    }

    for row in scenarios: Rectangle {
        background: #10161f;
        border-radius: 8px;
        height: 40px;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;
            Text {
                text: row.name;
                color: #d7dee8;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            AppButton { text: "Load"; small: true; clicked => { root.load(row.id); } }
            AppButton { text: "Delete"; small: true; danger: true; clicked => { root.delete(row.id); } }
        }
    }
}

component ScheduleTableRow inherits Rectangle {
    in property <AmortScheduleRow> data;
    height: 28px;
    HorizontalLayout {
        padding-right: 14px;
        Text { text: root.data.label; color: #d7dee8; font-size: 11px; width: 46px; vertical-alignment: center; }
        Text { text: root.data.paid; color: #d7dee8; font-size: 11px; horizontal-stretch: 1; horizontal-alignment: right; vertical-alignment: center; }
        Text { text: root.data.principal; color: #d7dee8; font-size: 11px; horizontal-stretch: 1; horizontal-alignment: right; vertical-alignment: center; }
        Text { text: root.data.interest; color: #d7dee8; font-size: 11px; horizontal-stretch: 1; horizontal-alignment: right; vertical-alignment: center; }
        Text { text: root.data.balance; color: #d7dee8; font-size: 11px; horizontal-stretch: 1; horizontal-alignment: right; vertical-alignment: center; }
    }
}

component ScheduleTable inherits VerticalLayout {
    in property <[AmortScheduleRow]> rows: [];
    in property <bool> show-full: false;
    callback toggle();

    spacing: 10px;

    HorizontalLayout {
        Text {
            text: show-full ? "Full schedule" : "Yearly summary";
            font-weight: 700;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        AppButton {
            text: show-full ? "Show yearly summary" : "Show every payment";
            small: true;
            clicked => { root.toggle(); }
        }
    }

    HorizontalLayout {
        padding-right: 14px;
        Text { text: show-full ? "Period" : "Year"; color: #92a0b3; font-size: 11px; width: 46px; }
        Text { text: "Paid"; color: #92a0b3; font-size: 11px; horizontal-stretch: 1; horizontal-alignment: right; }
        Text { text: "Principal"; color: #92a0b3; font-size: 11px; horizontal-stretch: 1; horizontal-alignment: right; }
        Text { text: "Interest"; color: #92a0b3; font-size: 11px; horizontal-stretch: 1; horizontal-alignment: right; }
        Text { text: "Balance"; color: #92a0b3; font-size: 11px; horizontal-stretch: 1; horizontal-alignment: right; }
    }

    // Yearly summary is short (well under 100 rows even at the longest
    // term we allow) so it renders directly in the page's own scroll flow
    // instead of a nested Flickable — Slint's Flickable claims a drag
    // that starts inside it whenever it has any overflow content, with no
    // scroll-chaining to the parent once it hits its own top/bottom, so a
    // second scroll region here is a real touch-scroll trap, not just a
    // visual nit. The full schedule can run to hundreds of rows, where an
    // unvirtualized list is the worse tradeoff — that one keeps ListView.
    if !show-full: VerticalLayout {
        for row in rows: ScheduleTableRow { data: row; }
    }
    if show-full: ListView {
        height: 320px;
        for row in rows: ScheduleTableRow { data: row; }
    }
}

component HabitToggle inherits Rectangle {
    in property <string> label;
    in property <string> amount-label;
    in-out property <bool> on: false;
    callback toggled();

    background: root.on ? #16321f : #10161f;
    border-radius: 8px;
    height: 44px;
    animate background { duration: 200ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.label; color: #d7dee8; font-size: 13px; }
            Text { text: root.amount-label; color: root.on ? #7ee787 : #5c6b80; font-size: 11px; }
        }
        Switch {
            checked <=> root.on;
            toggled => { root.toggled(); }
        }
    }
}

component WhatIfPanel inherits VerticalLayout {
    in-out property <bool> lattes-on: false;
    in-out property <bool> subscription-on: false;
    in-out property <bool> bonus-on: false;
    in property <string> boom-text: "";
    callback toggled();

    spacing: 10px;

    Text { text: "What if?"; font-weight: 700; font-size: 14px; }
    Text {
        text: "Flip a habit on to see how it speeds up payoff. Sets the extra payment above.";
        color: #92a0b3;
        font-size: 11px;
        wrap: word-wrap;
    }

    HabitToggle {
        label: "Skip 2 lattes a week";
        amount-label: "+$50/mo";
        on <=> root.lattes-on;
        toggled => { root.toggled(); }
    }
    HabitToggle {
        label: "Cancel an unused subscription";
        amount-label: "+$15/mo";
        on <=> root.subscription-on;
        toggled => { root.toggled(); }
    }
    HabitToggle {
        label: "Apply half your $2,000 bonus";
        amount-label: "+$83/mo";
        on <=> root.bonus-on;
        toggled => { root.toggled(); }
    }

    if root.boom-text != "": Rectangle {
        background: #16321f;
        border-radius: 10px;
        border-width: 1px;
        border-color: #2a5c3a;

        HorizontalLayout {
            padding: 12px;
            Text {
                text: root.boom-text;
                color: #7ee787;
                font-weight: 700;
                font-size: 14px;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }

        animate opacity { duration: 250ms; }
    }
}

component PayoffChart inherits Rectangle {
    in property <string> path-a: "";
    in property <string> path-b: "";
    in property <string> label-a: "Scenario A";
    in property <string> label-b: "Scenario B";
    in property <string> max-label: "";

    VerticalLayout {
        spacing: 8px;

        Text { text: "Remaining balance over time"; font-weight: 700; font-size: 14px; }

        HorizontalLayout {
            spacing: 14px;
            Rectangle { width: 10px; height: 10px; border-radius: 5px; background: #4f8cff; }
            Text { text: root.label-a; color: #92a0b3; font-size: 11px; }
            Rectangle { width: 10px; height: 10px; border-radius: 5px; background: #f59e0b; }
            Text { text: root.label-b; color: #92a0b3; font-size: 11px; }
            Rectangle { horizontal-stretch: 1; }
        }

        Rectangle {
            // Matches the 300x140 viewbox aspect ratio so the Path below
            // (which fits-and-centers its viewbox, preserving aspect ratio)
            // fills the box exactly instead of letterboxing.
            height: self.width * 140 / 300;
            background: #10161f;
            border-radius: 8px;
            clip: true;

            Path {
                width: 100%;
                height: 100%;
                viewbox-width: 300;
                viewbox-height: 140;
                stroke: #4f8cff;
                stroke-width: 2.5px;
                fill: transparent;
                commands: root.path-a;
            }
            Path {
                width: 100%;
                height: 100%;
                viewbox-width: 300;
                viewbox-height: 140;
                stroke: #f59e0b;
                stroke-width: 2.5px;
                fill: transparent;
                commands: root.path-b;
            }

            Text { x: 6px; y: 4px; text: root.max-label; color: #5c6b80; font-size: 9px; }
            Text { x: 6px; y: parent.height - self.height - 4px; text: "$0"; color: #5c6b80; font-size: 9px; }
        }

        HorizontalLayout {
            Text { text: "Today"; color: #5c6b80; font-size: 10px; horizontal-stretch: 1; }
            Text { text: "Payoff"; color: #5c6b80; font-size: 10px; horizontal-alignment: right; }
        }
    }
}

component EquityTimeline inherits VerticalLayout {
    in property <string> balance-path: "";
    in property <string> interest-path: "";
    in property <string> axis-max-label: "";
    in property <float> scrub-fraction: 0.0;
    in property <string> month-label: "";
    in property <string> balance-label: "";
    in property <string> interest-label: "";
    in property <string> equity-label: "";
    in property <float> equity-percent: 0.0;
    callback scrub(float);

    spacing: 10px;

    Text { text: "Payoff timeline"; font-weight: 700; font-size: 14px; }

    HorizontalLayout {
        spacing: 14px;
        Rectangle { width: 10px; height: 10px; border-radius: 5px; background: #4f8cff; }
        Text { text: "Remaining principal"; color: #92a0b3; font-size: 11px; }
        Rectangle { width: 10px; height: 10px; border-radius: 5px; background: #ef4444; }
        Text { text: "Interest paid so far"; color: #92a0b3; font-size: 11px; }
        Rectangle { horizontal-stretch: 1; }
    }

    chart-area := Rectangle {
        // See the matching comment in PayoffChart: this keeps the box's
        // aspect ratio equal to the Path's 300x140 viewbox so it fills the
        // box instead of letterboxing.
        height: self.width * 140 / 300;
        background: #10161f;
        border-radius: 8px;
        clip: true;

        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 300;
            viewbox-height: 140;
            stroke: #4f8cff;
            stroke-width: 2px;
            fill: transparent;
            commands: root.balance-path;
        }
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 300;
            viewbox-height: 140;
            stroke: #ef4444;
            stroke-width: 2px;
            fill: transparent;
            commands: root.interest-path;
        }

        Text { x: 6px; y: 4px; text: root.axis-max-label; color: #5c6b80; font-size: 9px; }
        Text { x: 6px; y: parent.height - self.height - 4px; text: "$0"; color: #5c6b80; font-size: 9px; }

        Rectangle {
            x: root.scrub-fraction * (parent.width - 2px);
            width: 2px;
            height: 100%;
            background: white;
            opacity: 0.55;
        }

        scrub-touch := TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.scrub(max(0.0, min(1.0, scrub-touch.mouse-x / self.width))); }
            moved => {
                if (self.pressed) {
                    root.scrub(max(0.0, min(1.0, scrub-touch.mouse-x / self.width)));
                }
            }
        }
    }

    HorizontalLayout {
        Text { text: "Today"; color: #5c6b80; font-size: 10px; horizontal-stretch: 1; }
        Text { text: "Payoff"; color: #5c6b80; font-size: 10px; horizontal-alignment: right; }
    }

    Text { text: root.month-label; font-weight: 700; font-size: 13px; color: white; }

    HorizontalLayout {
        spacing: 20px;
        VerticalLayout {
            spacing: 2px;
            Text { text: "Balance remaining"; color: #92a0b3; font-size: 11px; }
            Text { text: root.balance-label; color: #4f8cff; font-weight: 700; font-size: 14px; }
        }
        VerticalLayout {
            spacing: 2px;
            Text { text: "Interest paid"; color: #92a0b3; font-size: 11px; }
            Text { text: root.interest-label; color: #ef4444; font-weight: 700; font-size: 14px; }
        }
        VerticalLayout {
            spacing: 2px;
            Text { text: "Equity"; color: #92a0b3; font-size: 11px; }
            Text { text: root.equity-label; color: #7ee787; font-weight: 700; font-size: 14px; }
        }
    }

    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            spacing: 6px;
            alignment: center;
            house := Rectangle {
                width: 90px;
                height: 80px;

                Path {
                    width: 100%;
                    height: 34px;
                    y: 0px;
                    viewbox-width: 90;
                    viewbox-height: 34;
                    commands: "M 2 34 L 45 2 L 88 34";
                    stroke: #5c6b80;
                    stroke-width: 2px;
                    fill: transparent;
                }

                body := Rectangle {
                    y: 30px;
                    height: parent.height - 30px;
                    width: 100%;
                    border-width: 2px;
                    border-color: #5c6b80;
                    background: transparent;
                    clip: true;

                    Rectangle {
                        y: parent.height * (1 - root.equity-percent / 100);
                        height: parent.height * (root.equity-percent / 100);
                        width: 100%;
                        background: root.equity-percent >= 50 ? #22c55e : #4f8cff;
                        animate y, height, background { duration: 200ms; }
                    }
                }
            }
            Text {
                text: round(root.equity-percent) + "% equity";
                color: #92a0b3;
                font-size: 11px;
                horizontal-alignment: center;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Mortgage Calculator";
    // Title bar and taskbar entry on desktop. iOS and Android take their
    // icons from the app bundle instead, and macOS from the .app -- so this
    // only actually shows up on Linux, Windows, and `cargo run`.
    icon: @image-url("app-icon.png");
    preferred-width: 520px;
    preferred-height: 840px;
    background: #0b1119;

    in-out property <int> current-tab: 0;

    // --- Region: "US" or "SG". Drives which regulatory limits, upfront
    // costs, and terminology the calculators and labels below use.
    // Auto-detected from the device locale at startup (see run_app in
    // lib.rs); the header toggle lets the user override it.
    in-out property <string> region: "US";
    callback region-changed(string);

    // --- Payment ---
    in-out property <string> principal: "400000";
    in-out property <string> rate-percent: "6.5";
    in-out property <float> rate-percent-value: 6.5;
    in-out property <string> term-years: "30";
    in-out property <string> payment-result: "";
    in-out property <string> total-paid-result: "";
    in-out property <string> total-interest-result: "";
    in-out property <bool> has-error: false;
    in-out property <string> error-text: "";
    in-out property <[ScenarioRow]> payment-scenarios: [];
    in-out property <string> payment-scenario-error: "";
    callback recompute();
    callback rate-slider-changed(float);
    callback payment-save-scenario(string);
    callback payment-load-scenario(string);
    callback payment-delete-scenario(string);

    // --- Payment: Singapore panel (region == "SG" only) ---
    in-out property <string> sg-gross-income: "8000";
    in-out property <string> sg-other-debts: "0";
    in-out property <bool> sg-is-hdb: true;
    in-out property <string> sg-loan-type: "HDB Loan";
    in-out property <string> sg-loan-type-warning: "";
    in-out property <string> sg-tdsr-label: "";
    in-out property <bool> sg-tdsr-exceeded: false;
    in-out property <bool> sg-tdsr-near: false;
    in-out property <string> sg-msr-label: "";
    in-out property <bool> sg-msr-exceeded: false;
    in-out property <bool> sg-msr-near: false;
    in-out property <string> sg-limit-warning: "";
    in-out property <bool> sg-use-cpf: false;
    in-out property <string> sg-cpf-oa-available: "1500";
    in-out property <string> sg-cpf-used-label: "";
    in-out property <string> sg-cash-required-label: "";
    in-out property <string> sg-home-price: "1000000";
    in-out property <string> sg-residency: "Citizen";
    in-out property <string> sg-property-count: "1st";
    in-out property <string> sg-bsd-label: "";
    in-out property <string> sg-absd-label: "";
    in-out property <string> sg-upfront-total-label: "";
    in-out property <string> sg-down-payment-label: "";
    in-out property <string> sg-total-cash-required-label: "";

    // --- Payment: United States panel (region == "US" only) ---
    in-out property <string> us-home-price: "500000";
    in-out property <string> us-loan-type-label: "";
    in-out property <string> us-zip: "90210";
    in-out property <string> us-property-tax-rate-label: "";
    in-out property <string> us-monthly-property-tax-label: "";
    in-out property <string> us-down-payment-percent-label: "";
    in-out property <float> us-down-payment-percent-value: 20.0;
    callback us-down-payment-changed(float);
    in-out property <bool> us-pmi-required: false;
    in-out property <string> us-pmi-rate-percent: "0.75";
    in-out property <string> us-monthly-pmi-label: "";
    in-out property <bool> us-use-tax-deduction: false;
    in-out property <string> us-marginal-tax-rate-percent: "22";
    in-out property <string> us-monthly-tax-savings-label: "";
    in-out property <string> us-monthly-piti-label: "";
    in-out property <string> us-net-monthly-cost-label: "";

    // --- Amortization ---
    in-out property <string> amort-principal: "400000";
    in-out property <string> amort-rate-percent: "6.5";
    in-out property <float> amort-rate-percent-value: 6.5;
    in-out property <string> amort-term-years: "30";
    in-out property <string> amort-extra-payment: "0";
    in-out property <string> amort-payment-result: "";
    in-out property <string> amort-total-paid-result: "";
    in-out property <string> amort-total-interest-result: "";
    in-out property <bool> amort-has-error: false;
    in-out property <string> amort-error-text: "";
    in-out property <bool> amort-show-impact: false;
    in-out property <string> amort-periods-saved: "";
    in-out property <string> amort-interest-saved: "";
    in-out property <string> amort-new-payoff: "";
    in-out property <string> amort-boom-text: "";
    in-out property <bool> amort-lattes-on: false;
    in-out property <bool> amort-subscription-on: false;
    in-out property <bool> amort-bonus-on: false;
    in-out property <string> amort-timeline-balance-path: "";
    in-out property <string> amort-timeline-interest-path: "";
    in-out property <string> amort-timeline-axis-max-label: "";
    // Defaults to the midpoint rather than 0.0 so the timeline opens on a
    // representative mid-loan snapshot instead of looking broken/empty
    // (Month 1, 0% equity, scrub line flush against the left edge).
    in-out property <float> amort-scrub-fraction: 0.5;
    in-out property <string> amort-scrub-month-label: "";
    in-out property <string> amort-scrub-balance-label: "";
    in-out property <string> amort-scrub-interest-label: "";
    in-out property <string> amort-scrub-equity-label: "";
    in-out property <float> amort-scrub-equity-percent: 0.0;
    in-out property <[AmortScheduleRow]> amort-schedule-rows: [];
    in-out property <bool> amort-show-full: false;
    in-out property <[ScenarioRow]> amort-scenarios: [];
    in-out property <string> amort-scenario-error: "";
    callback amort-recompute();
    callback amort-rate-slider-changed(float);
    callback amort-whatif-toggled();
    callback amort-scrub(float);
    callback amort-toggle-full();
    callback amort-save-scenario(string);
    callback amort-load-scenario(string);
    callback amort-delete-scenario(string);

    // --- Affordability ---
    in-out property <string> aff-income: "10000";
    in-out property <string> aff-debts: "500";
    in-out property <string> aff-down-payment: "60000";
    in-out property <string> aff-rate-percent: "6.5";
    in-out property <float> aff-rate-percent-value: 6.5;
    in-out property <string> aff-term-years: "30";
    in-out property <string> aff-max-dti-percent: "36";
    in-out property <string> aff-tax-rate-percent: "1.2";
    in-out property <string> aff-insurance: "1500";
    in-out property <string> aff-hoa: "0";
    in-out property <string> aff-max-home-price: "";
    in-out property <string> aff-max-loan-amount: "";
    in-out property <string> aff-max-pi: "";
    in-out property <string> aff-front-dti: "";
    in-out property <string> aff-back-dti: "";
    in-out property <bool> aff-has-error: false;
    in-out property <string> aff-error-text: "";
    in-out property <[ScenarioRow]> aff-scenarios: [];
    in-out property <string> aff-scenario-error: "";
    callback aff-recompute();
    callback aff-rate-slider-changed(float);
    callback aff-save-scenario(string);
    callback aff-load-scenario(string);
    callback aff-delete-scenario(string);

    // --- Refinance ---
    in-out property <string> refi-current-balance: "300000";
    in-out property <string> refi-current-rate-percent: "7.5";
    in-out property <float> refi-current-rate-percent-value: 7.5;
    in-out property <string> refi-remaining-periods: "300";
    in-out property <string> refi-new-rate-percent: "6.0";
    in-out property <float> refi-new-rate-percent-value: 6.0;
    in-out property <string> refi-new-term-years: "30";
    in-out property <string> refi-closing-costs: "6000";
    in-out property <string> refi-current-payment: "";
    in-out property <string> refi-new-payment: "";
    in-out property <string> refi-payment-savings: "";
    in-out property <string> refi-break-even: "";
    in-out property <string> refi-lifetime-savings: "";
    in-out property <bool> refi-has-error: false;
    in-out property <string> refi-error-text: "";
    in-out property <[ScenarioRow]> refi-scenarios: [];
    in-out property <string> refi-scenario-error: "";
    callback refi-recompute();
    callback refi-current-rate-slider-changed(float);
    callback refi-new-rate-slider-changed(float);
    callback refi-save-scenario(string);
    callback refi-load-scenario(string);
    callback refi-delete-scenario(string);

    // --- Compare (two fixed scenario slots) ---
    in-out property <string> cmp-principal: "400000";
    in-out property <string> cmp-a-label: "30-Year Fixed";
    in-out property <bool> cmp-a-floating: false;
    in-out property <string> cmp-a-rate-percent: "6.5";
    in-out property <float> cmp-a-rate-percent-value: 6.5;
    in-out property <string> cmp-a-base-rate-percent: "4.3";
    in-out property <string> cmp-a-spread-percent: "2.0";
    in-out property <string> cmp-a-term-years: "30";
    in-out property <string> cmp-a-result: "";
    in-out property <string> cmp-b-label: "15-Year Fixed";
    in-out property <bool> cmp-b-floating: false;
    in-out property <string> cmp-b-rate-percent: "6.0";
    in-out property <float> cmp-b-rate-percent-value: 6.0;
    in-out property <string> cmp-b-base-rate-percent: "4.3";
    in-out property <string> cmp-b-spread-percent: "2.5";
    in-out property <string> cmp-b-term-years: "15";
    in-out property <string> cmp-b-result: "";
    in-out property <bool> cmp-has-error: false;
    in-out property <string> cmp-error-text: "";
    in-out property <string> cmp-chart-path-a: "";
    in-out property <string> cmp-chart-path-b: "";
    in-out property <string> cmp-chart-max-label: "";
    in-out property <string> cmp-summary-text: "";
    in-out property <[ScenarioRow]> cmp-scenarios: [];
    in-out property <string> cmp-scenario-error: "";
    callback cmp-recompute();
    callback cmp-a-rate-slider-changed(float);
    callback cmp-b-rate-slider-changed(float);
    callback cmp-save-scenario(string);
    callback cmp-load-scenario(string);
    callback cmp-delete-scenario(string);

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        HorizontalLayout {
            Text {
                text: "Mortgage Calculator";
                font-size: 22px;
                font-weight: 800;
                color: white;
            }
            Rectangle { horizontal-stretch: 1; }
            AboutButton { }
            Rectangle { width: 8px; }
            RegionToggle {
                region <=> root.region;
                changed(r) => { root.region-changed(r); }
            }
        }

        Rectangle {
            background: #10161f;
            border-radius: 10px;
            height: 44px;

            HorizontalLayout {
                padding: 4px;
                spacing: 4px;
                TabBarButton { text: "Payment"; active: current-tab == 0; clicked => { root.current-tab = 0; } }
                TabBarButton { text: "Amortization"; active: current-tab == 1; clicked => { root.current-tab = 1; } }
                TabBarButton { text: "Affordability"; active: current-tab == 2; clicked => { root.current-tab = 2; } }
                TabBarButton { text: "Refinance"; active: current-tab == 3; clicked => { root.current-tab = 3; } }
                TabBarButton { text: "Compare"; active: current-tab == 4; clicked => { root.current-tab = 4; } }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 16px;

        if current-tab == 0: VerticalLayout {
            spacing: 16px;
            Card {
                Field {
                    label: "Home loan amount";
                    LineEdit {
                        input-type: InputType.decimal;
                        text <=> root.principal;
                        edited => { root.recompute(); }
                    }
                }
                RateField {
                    label: "Interest rate (%)";
                    rate <=> root.rate-percent-value;
                    value <=> root.rate-percent;
                    edited => { root.recompute(); }
                    rate-changed(v) => { root.rate-slider-changed(v); }
                }
                Field {
                    label: "Loan term (years)";
                    LineEdit {
                        input-type: InputType.number;
                        text <=> root.term-years;
                        edited => { root.recompute(); }
                    }
                }
            }

            if !root.has-error: Card {
                ResultRow { label: "Payment"; value: root.payment-result; emphasize: true; }
                ResultRow { label: "Total paid"; value: root.total-paid-result; }
                ResultRow { label: "Total interest"; value: root.total-interest-result; }
            }
            if root.has-error: Card {
                ErrorText { text: root.error-text; }
            }

            if root.region == "SG": Card {
                Text { text: "Singapore"; font-weight: 700; font-size: 14px; }

                Field {
                    label: "Gross monthly income";
                    LineEdit { input-type: InputType.decimal; text <=> root.sg-gross-income; edited => { root.recompute(); } }
                }
                Field {
                    label: "Other monthly debts";
                    LineEdit { input-type: InputType.decimal; text <=> root.sg-other-debts; edited => { root.recompute(); } }
                }
                HorizontalLayout {
                    Text {
                        text: "HDB flat / EC (MSR applies)";
                        color: #92a0b3;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    CheckBox { checked <=> root.sg-is-hdb; toggled => { root.recompute(); } }
                }
                Field {
                    label: "Loan type";
                    ComboBox {
                        model: ["HDB Loan", "Bank Loan"];
                        current-value <=> root.sg-loan-type;
                        selected => { root.recompute(); }
                    }
                }
                if root.sg-loan-type-warning != "": ErrorText { text: root.sg-loan-type-warning; }

                LimitBar {
                    label: "TDSR (max 55%)";
                    value-label: root.sg-tdsr-label;
                    exceeded: root.sg-tdsr-exceeded;
                    near-limit: root.sg-tdsr-near;
                }
                if root.sg-is-hdb: LimitBar {
                    label: "MSR (max 30%, HDB/EC)";
                    value-label: root.sg-msr-label;
                    exceeded: root.sg-msr-exceeded;
                    near-limit: root.sg-msr-near;
                }
                if root.sg-limit-warning != "": ErrorText { text: root.sg-limit-warning; }

                HorizontalLayout {
                    Text {
                        text: "Use CPF OA for monthly payment";
                        color: #92a0b3;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Switch { checked <=> root.sg-use-cpf; toggled => { root.recompute(); } }
                }
                if root.sg-use-cpf: Field {
                    label: "Monthly CPF OA available";
                    LineEdit { input-type: InputType.decimal; text <=> root.sg-cpf-oa-available; edited => { root.recompute(); } }
                }
                if root.sg-use-cpf: ResultRow { label: "CPF OA portion"; value: root.sg-cpf-used-label; }
                if root.sg-use-cpf: ResultRow { label: "Cash required"; value: root.sg-cash-required-label; emphasize: true; }
            }

            if root.region == "SG": Card {
                Text { text: "Upfront costs (BSD/ABSD)"; font-weight: 700; font-size: 14px; }
                Field {
                    label: "Home purchase price";
                    LineEdit { input-type: InputType.decimal; text <=> root.sg-home-price; edited => { root.recompute(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text { text: "Residency"; color: #92a0b3; font-size: 12px; }
                        ComboBox {
                            model: ["Citizen", "PR", "Foreigner"];
                            current-value <=> root.sg-residency;
                            selected => { root.recompute(); }
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text { text: "Property count"; color: #92a0b3; font-size: 12px; }
                        ComboBox {
                            model: ["1st", "2nd", "3rd+"];
                            current-value <=> root.sg-property-count;
                            selected => { root.recompute(); }
                        }
                    }
                }
                ResultRow { label: "Buyer's Stamp Duty (BSD)"; value: root.sg-bsd-label; }
                ResultRow { label: "Additional BSD (ABSD)"; value: root.sg-absd-label; }
                ResultRow { label: "Total upfront stamp duty"; value: root.sg-upfront-total-label; }
                ResultRow { label: "Down payment"; value: root.sg-down-payment-label; }
                ResultRow { label: "Total cash required"; value: root.sg-total-cash-required-label; emphasize: true; }
            }

            if root.region == "US": Card {
                Text { text: "United States"; font-weight: 700; font-size: 14px; }

                Field {
                    label: "Home price";
                    LineEdit { input-type: InputType.decimal; text <=> root.us-home-price; edited => { root.recompute(); } }
                }
                ResultRow { label: "Loan type"; value: root.us-loan-type-label; }
                Field {
                    label: "Down payment (" + root.us-down-payment-percent-label + ")";
                    RiskSlider {
                        risk-coloring: false;
                        minimum: 0.0;
                        maximum: 50.0;
                        value <=> root.us-down-payment-percent-value;
                        changed(v) => { root.us-down-payment-changed(v); }
                    }
                }
                Field {
                    label: "ZIP code";
                    LineEdit { input-type: InputType.number; text <=> root.us-zip; edited => { root.recompute(); } }
                }
                ResultRow { label: "Est. property tax rate"; value: root.us-property-tax-rate-label; }
                ResultRow { label: "Monthly property tax"; value: root.us-monthly-property-tax-label; }

                // Animates open rather than snapping in/out, per the feature
                // request: PMI should "smoothly animate into the monthly
                // cost breakdown" the moment down payment drops below 20%.
                Rectangle {
                    clip: true;
                    height: root.us-pmi-required ? 74px : 0px;
                    animate height { duration: 200ms; easing: ease-in-out; }

                    VerticalLayout {
                        spacing: 12px;
                        opacity: root.us-pmi-required ? 1.0 : 0.0;
                        animate opacity { duration: 200ms; }

                        ResultRow {
                            label: "PMI (required, down payment < 20%)";
                            value: root.us-monthly-pmi-label;
                        }
                        Field {
                            label: "PMI rate (annual %, of loan amount)";
                            LineEdit { input-type: InputType.decimal; text <=> root.us-pmi-rate-percent; edited => { root.recompute(); } }
                        }
                    }
                }

                ResultRow { label: "Estimated monthly PITI"; value: root.us-monthly-piti-label; emphasize: true; }

                HorizontalLayout {
                    Text {
                        text: "Show net cost after tax deductions";
                        color: #92a0b3;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Switch { checked <=> root.us-use-tax-deduction; toggled => { root.recompute(); } }
                }
                if root.us-use-tax-deduction: Field {
                    label: "Marginal federal tax rate (%)";
                    LineEdit { input-type: InputType.decimal; text <=> root.us-marginal-tax-rate-percent; edited => { root.recompute(); } }
                }
                if root.us-use-tax-deduction: ResultRow {
                    label: "Monthly tax savings";
                    value: root.us-monthly-tax-savings-label;
                }
                if root.us-use-tax-deduction: ResultRow {
                    label: "Net monthly cost";
                    value: root.us-net-monthly-cost-label;
                    emphasize: true;
                }
            }

            Card {
                SavedScenariosPanel {
                    scenarios: root.payment-scenarios;
                    error-text: root.payment-scenario-error;
                    save(name) => { root.payment-save-scenario(name); }
                    load(id) => { root.payment-load-scenario(id); }
                    delete(id) => { root.payment-delete-scenario(id); }
                }
            }
        }

        if current-tab == 1: VerticalLayout {
            spacing: 16px;
            Card {
                Field {
                    label: "Home loan amount";
                    LineEdit {
                        input-type: InputType.decimal;
                        text <=> root.amort-principal;
                        edited => { root.amort-recompute(); }
                    }
                }
                RateField {
                    label: "Interest rate (%)";
                    rate <=> root.amort-rate-percent-value;
                    value <=> root.amort-rate-percent;
                    edited => { root.amort-recompute(); }
                    rate-changed(v) => { root.amort-rate-slider-changed(v); }
                }
                Field {
                    label: "Loan term (years)";
                    LineEdit {
                        input-type: InputType.number;
                        text <=> root.amort-term-years;
                        edited => { root.amort-recompute(); }
                    }
                }
                Field {
                    label: "Extra payment per month";
                    LineEdit {
                        input-type: InputType.decimal;
                        text <=> root.amort-extra-payment;
                        edited => { root.amort-recompute(); }
                    }
                }
            }

            if !root.amort-has-error: Card {
                ResultRow { label: "Payment"; value: root.amort-payment-result; emphasize: true; }
                ResultRow { label: "Total paid"; value: root.amort-total-paid-result; }
                ResultRow { label: "Total interest"; value: root.amort-total-interest-result; }
                if root.amort-show-impact: Text {
                    text: "Extra payments save " + root.amort-periods-saved + " payments and " + root.amort-interest-saved + " in interest (payoff in " + root.amort-new-payoff + " payments)";
                    color: #7ee787;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
            if root.amort-has-error: Card {
                ErrorText { text: root.amort-error-text; }
            }

            if !root.amort-has-error: Card {
                EquityTimeline {
                    balance-path: root.amort-timeline-balance-path;
                    interest-path: root.amort-timeline-interest-path;
                    axis-max-label: root.amort-timeline-axis-max-label;
                    scrub-fraction: root.amort-scrub-fraction;
                    month-label: root.amort-scrub-month-label;
                    balance-label: root.amort-scrub-balance-label;
                    interest-label: root.amort-scrub-interest-label;
                    equity-label: root.amort-scrub-equity-label;
                    equity-percent: root.amort-scrub-equity-percent;
                    scrub(v) => { root.amort-scrub(v); }
                }
            }

            if !root.amort-has-error: Card {
                WhatIfPanel {
                    lattes-on <=> root.amort-lattes-on;
                    subscription-on <=> root.amort-subscription-on;
                    bonus-on <=> root.amort-bonus-on;
                    boom-text: root.amort-boom-text;
                    toggled => { root.amort-whatif-toggled(); }
                }
            }

            if !root.amort-has-error: Card {
                ScheduleTable {
                    rows: root.amort-schedule-rows;
                    show-full: root.amort-show-full;
                    toggle => { root.amort-toggle-full(); }
                }
            }

            Card {
                SavedScenariosPanel {
                    scenarios: root.amort-scenarios;
                    error-text: root.amort-scenario-error;
                    save(name) => { root.amort-save-scenario(name); }
                    load(id) => { root.amort-load-scenario(id); }
                    delete(id) => { root.amort-delete-scenario(id); }
                }
            }
        }

        if current-tab == 2: VerticalLayout {
            spacing: 16px;
            Card {
                Text { text: "Your finances"; font-weight: 700; font-size: 14px; }
                Field {
                    label: "Gross monthly income";
                    LineEdit { input-type: InputType.decimal; text <=> root.aff-income; edited => { root.aff-recompute(); } }
                }
                Field {
                    label: "Other monthly debts";
                    LineEdit { input-type: InputType.decimal; text <=> root.aff-debts; edited => { root.aff-recompute(); } }
                }
                Field {
                    label: "Down payment";
                    LineEdit { input-type: InputType.decimal; text <=> root.aff-down-payment; edited => { root.aff-recompute(); } }
                }
            }

            Card {
                Text { text: "Loan & property costs"; font-weight: 700; font-size: 14px; }
                RateField {
                    label: "Interest rate (%)";
                    rate <=> root.aff-rate-percent-value;
                    value <=> root.aff-rate-percent;
                    edited => { root.aff-recompute(); }
                    rate-changed(v) => { root.aff-rate-slider-changed(v); }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Field {
                        label: "Loan term (years)";
                        LineEdit { input-type: InputType.number; text <=> root.aff-term-years; edited => { root.aff-recompute(); } }
                    }
                    Field {
                        label: "Max debt-to-income (%)";
                        LineEdit { input-type: InputType.decimal; text <=> root.aff-max-dti-percent; edited => { root.aff-recompute(); } }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Field {
                        label: "Property tax rate (%/yr)";
                        LineEdit { input-type: InputType.decimal; text <=> root.aff-tax-rate-percent; edited => { root.aff-recompute(); } }
                    }
                    Field {
                        label: "Annual insurance";
                        LineEdit { input-type: InputType.decimal; text <=> root.aff-insurance; edited => { root.aff-recompute(); } }
                    }
                }
                Field {
                    label: root.region == "SG" ? "Monthly maintenance / condo fees" : "Monthly HOA";
                    LineEdit { input-type: InputType.decimal; text <=> root.aff-hoa; edited => { root.aff-recompute(); } }
                }
            }

            if !root.aff-has-error: Card {
                ResultRow { label: "Max home price"; value: root.aff-max-home-price; emphasize: true; }
                ResultRow { label: "Max loan amount"; value: root.aff-max-loan-amount; }
                ResultRow { label: "Principal & interest"; value: root.aff-max-pi; }
                ResultRow { label: "Front-end DTI"; value: root.aff-front-dti + "%"; }
                ResultRow { label: "Back-end DTI"; value: root.aff-back-dti + "%"; }
            }
            if root.aff-has-error: Card {
                ErrorText { text: root.aff-error-text; }
            }

            Card {
                SavedScenariosPanel {
                    scenarios: root.aff-scenarios;
                    error-text: root.aff-scenario-error;
                    save(name) => { root.aff-save-scenario(name); }
                    load(id) => { root.aff-load-scenario(id); }
                    delete(id) => { root.aff-delete-scenario(id); }
                }
            }
        }

        if current-tab == 3: VerticalLayout {
            spacing: 16px;
            Card {
                Field {
                    label: "Current balance";
                    LineEdit { input-type: InputType.decimal; text <=> root.refi-current-balance; edited => { root.refi-recompute(); } }
                }
                RateField {
                    label: "Current rate (%)";
                    rate <=> root.refi-current-rate-percent-value;
                    value <=> root.refi-current-rate-percent;
                    // Already-fixed and unchangeable by anything on this
                    // tab — a "danger" red reads as a warning about an
                    // input the user can't act on, so this stays plain blue.
                    risk-coloring: false;
                    edited => { root.refi-recompute(); }
                    rate-changed(v) => { root.refi-current-rate-slider-changed(v); }
                }
                Field {
                    label: "Payments remaining";
                    LineEdit { input-type: InputType.number; text <=> root.refi-remaining-periods; edited => { root.refi-recompute(); } }
                }
                RateField {
                    label: "New rate (%)";
                    rate <=> root.refi-new-rate-percent-value;
                    value <=> root.refi-new-rate-percent;
                    edited => { root.refi-recompute(); }
                    rate-changed(v) => { root.refi-new-rate-slider-changed(v); }
                }
                Field {
                    label: "New term (years)";
                    LineEdit { input-type: InputType.number; text <=> root.refi-new-term-years; edited => { root.refi-recompute(); } }
                }
                Field {
                    label: "Closing costs";
                    LineEdit { input-type: InputType.decimal; text <=> root.refi-closing-costs; edited => { root.refi-recompute(); } }
                }
            }

            if !root.refi-has-error: Card {
                ResultRow { label: "Current payment"; value: root.refi-current-payment; }
                ResultRow { label: "New payment"; value: root.refi-new-payment; }
                ResultRow { label: "Monthly savings"; value: root.refi-payment-savings; emphasize: true; }
                ResultRow { label: "Break-even"; value: root.refi-break-even; }
                ResultRow { label: "Lifetime savings"; value: root.refi-lifetime-savings; }
            }
            if root.refi-has-error: Card {
                ErrorText { text: root.refi-error-text; }
            }

            Card {
                SavedScenariosPanel {
                    scenarios: root.refi-scenarios;
                    error-text: root.refi-scenario-error;
                    save(name) => { root.refi-save-scenario(name); }
                    load(id) => { root.refi-load-scenario(id); }
                    delete(id) => { root.refi-delete-scenario(id); }
                }
            }
        }

        if current-tab == 4: VerticalLayout {
            spacing: 16px;
            Card {
                Field {
                    label: "Home loan amount";
                    LineEdit {
                        input-type: InputType.decimal;
                        text <=> root.cmp-principal;
                        edited => { root.cmp-recompute(); }
                    }
                }
            }

            if !root.cmp-has-error: Card {
                PayoffChart {
                    path-a: root.cmp-chart-path-a;
                    path-b: root.cmp-chart-path-b;
                    label-a: root.cmp-a-label;
                    label-b: root.cmp-b-label;
                    max-label: root.cmp-chart-max-label;
                }
            }

            if !root.cmp-has-error && root.cmp-summary-text != "": Rectangle {
                background: #16321f;
                border-radius: 10px;
                border-width: 1px;
                border-color: #2a5c3a;

                HorizontalLayout {
                    padding: 12px;
                    Text {
                        text: root.cmp-summary-text;
                        color: #7ee787;
                        font-weight: 700;
                        font-size: 13px;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }

            Card {
                Text { text: "Scenario A"; font-weight: 700; font-size: 14px; }
                LineEdit {
                    text <=> root.cmp-a-label;
                }
                CheckBox {
                    text: "Floating rate";
                    checked <=> root.cmp-a-floating;
                    toggled => { root.cmp-recompute(); }
                }
                if !root.cmp-a-floating: RateField {
                    label: "Rate (%)";
                    rate <=> root.cmp-a-rate-percent-value;
                    value <=> root.cmp-a-rate-percent;
                    edited => { root.cmp-recompute(); }
                    rate-changed(v) => { root.cmp-a-rate-slider-changed(v); }
                }
                if root.cmp-a-floating: HorizontalLayout {
                    spacing: 10px;
                    Field {
                        label: "Base (%)";
                        LineEdit {
                            input-type: InputType.decimal;
                            text <=> root.cmp-a-base-rate-percent;
                            edited => { root.cmp-recompute(); }
                        }
                    }
                    Field {
                        label: "Spread (%)";
                        LineEdit {
                            input-type: InputType.decimal;
                            text <=> root.cmp-a-spread-percent;
                            edited => { root.cmp-recompute(); }
                        }
                    }
                }
                Field {
                    label: "Term (years)";
                    LineEdit {
                        input-type: InputType.number;
                        text <=> root.cmp-a-term-years;
                        edited => { root.cmp-recompute(); }
                    }
                }
                Text { text: root.cmp-a-result; font-weight: 700; font-size: 13px; color: #7ee787; wrap: word-wrap; }
            }

            Card {
                Text { text: "Scenario B"; font-weight: 700; font-size: 14px; }
                LineEdit {
                    text <=> root.cmp-b-label;
                }
                CheckBox {
                    text: "Floating rate";
                    checked <=> root.cmp-b-floating;
                    toggled => { root.cmp-recompute(); }
                }
                if !root.cmp-b-floating: RateField {
                    label: "Rate (%)";
                    rate <=> root.cmp-b-rate-percent-value;
                    value <=> root.cmp-b-rate-percent;
                    edited => { root.cmp-recompute(); }
                    rate-changed(v) => { root.cmp-b-rate-slider-changed(v); }
                }
                if root.cmp-b-floating: HorizontalLayout {
                    spacing: 10px;
                    Field {
                        label: "Base (%)";
                        LineEdit {
                            input-type: InputType.decimal;
                            text <=> root.cmp-b-base-rate-percent;
                            edited => { root.cmp-recompute(); }
                        }
                    }
                    Field {
                        label: "Spread (%)";
                        LineEdit {
                            input-type: InputType.decimal;
                            text <=> root.cmp-b-spread-percent;
                            edited => { root.cmp-recompute(); }
                        }
                    }
                }
                Field {
                    label: "Term (years)";
                    LineEdit {
                        input-type: InputType.number;
                        text <=> root.cmp-b-term-years;
                        edited => { root.cmp-recompute(); }
                    }
                }
                Text { text: root.cmp-b-result; font-weight: 700; font-size: 13px; color: #7ee787; wrap: word-wrap; }
            }

            if root.cmp-has-error: Card {
                ErrorText { text: root.cmp-error-text; }
            }

            Card {
                SavedScenariosPanel {
                    scenarios: root.cmp-scenarios;
                    error-text: root.cmp-scenario-error;
                    save(name) => { root.cmp-save-scenario(name); }
                    load(id) => { root.cmp-load-scenario(id); }
                    delete(id) => { root.cmp-delete-scenario(id); }
                }
            }
        }

            }
        }
    }
}
